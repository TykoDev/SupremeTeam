# Runtime state and local run deliverables; never commit.
skillset-saves/
.harness-state/
.supremeteam/
harness-test-work/
gatekeeper-test-work/
.playwright-mcp/
__pycache__/
*.pyc
.pytest_cache/

# Local environments, credentials and machine files.
.venv/
.env
.env.*
.DS_Store
.claude/worktrees/

# Everything skills/scripts/package_check.py refuses to package: credential
# files, archives and skill-eval workspaces. Ignoring them here keeps `git add .`
# from staging what the delivery check would then reject.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
.npmrc
.netrc
.pypirc
credentials*.json
*.zip
*.skill
*-workspace/
**/evals/workspace/

# Coverage residue. Coverage data belongs in the run at
# skillset-saves/runs/<run>/<phase>/evidence/coverage/ (output_paths.py --kind
# coverage); anything matching these at the project root is residue a step left
# behind, and post_tool_use.py relocates it on the next tool call.
.coverage
.coverage.*
.coverage/
htmlcov/
.nyc_output/
